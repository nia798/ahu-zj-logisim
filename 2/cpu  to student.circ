  <circuit name="◇单周期MIPS(硬布线)">
    <a name="circuit" val="◇单周期MIPS(硬布线)"/>
    <a name="clabel" val=""/>
    <a name="clabelup" val="east"/>
    <a name="clabelfont" val="SansSerif plain 12"/>
    <a name="clabelcolor" val="#000000"/>
    <wire from="(10,10)" to="(10,140)"/>
    <wire from="(450,10)" to="(450,140)"/>
    <wire from="(10,10)" to="(450,10)"/>
    <wire from="(10,140)" to="(450,140)"/>
    <wire from="(450,10)" to="(1140,10)"/>
    <wire from="(450,140)" to="(1140,140)"/>
    <wire from="(1140,10)" to="(1140,140)"/>
    <wire from="(50,80)" to="(90,80)"/>
    <wire from="(350,50)" to="(350,80)"/>
    <wire from="(180,80)" to="(210,80)"/>
    <wire from="(740,40)" to="(740,80)"/>
    <wire from="(950,40)" to="(950,80)"/>
